{
  "format": "talesmith-lang",
  "version": 1,
  "header": {
    "page": {
      "formatId": "web",
      "kind": "web",
      "trimMM": { "width": 210, "height": 297 },
      "marginsMM": { "top": 12, "bottom": 12, "outside": 15, "gutter": 15 },
      "headerTopMM": 3,
      "footerBottomMM": 3,
      "headerRule": true,
      "footerRule": true,
      "rowGapMM": 2,
      "usePrintGutters": true
    },
    "typography": {
      "fontId": "book-serif",
      "fontFamily": "Georgia, \"Times New Roman\", serif",
      "sizePt": 12,
      "lineHeight": 1.5,
      "paragraphAlign": "left",
      "paragraphIndentIn": 0,
      "paragraphSpacingPt": 0,
      "hyphenation": true
    },
    "numbering": { "startPage": 1, "pageOffsetStart": 0, "firstPhysicalPageSide": "left" },
    "theme": "default",
    "readMode": true,
    "metadata": { "title": "Rich content blocks", "fields": [] },
    "mergeFields": { "version": 1, "fields": [], "values": { "title": "Rich content blocks" } }
  },
  "document": {
    "blocks": [
      {
        "id": "t1",
        "type": "title",
        "align": "center",
        "text": "Rich content blocks"
      },
      {
        "id": "p1",
        "type": "paragraph",
        "text": "A compact sample of the heaviest everyday blocks: lists, figures, tables, code, and asides."
      },
      {
        "id": "h1",
        "type": "h1",
        "text": "Prose and lists"
      },
      {
        "id": "q1",
        "type": "quote",
        "text": "Blockquotes carry attribution and indentation without extra markup wrappers."
      },
      {
        "id": "b1",
        "type": "bullet",
        "bulletStyle": "disc",
        "text": "Bulleted list item with inline <strong>emphasis</strong>"
      },
      {
        "id": "b2",
        "type": "bullet",
        "bulletStyle": "disc",
        "text": "Second item; use <code>todo</code> blocks for checklists"
      },
      {
        "id": "td1",
        "type": "todo",
        "checked": true,
        "text": "Completed task"
      },
      {
        "id": "td2",
        "type": "todo",
        "checked": false,
        "text": "Open task"
      },
      {
        "id": "h2",
        "type": "h2",
        "text": "Code"
      },
      {
        "id": "c1",
        "type": "code",
        "text": "{\n  \"format\": \"talesmith-lang\",\n  \"version\": 1\n}"
      },
      {
        "id": "h3",
        "type": "h2",
        "text": "Aside and divider"
      },
      {
        "id": "a1",
        "type": "aside",
        "text": "Asides are margin notes or callouts; they can span one or two columns via <code>cols</code>."
      },
      {
        "id": "d1",
        "type": "divider"
      },
      {
        "id": "h4",
        "type": "h2",
        "text": "Table"
      },
      {
        "id": "tbl1",
        "type": "table",
        "header": true,
        "cells": [
          ["Block", "Role"],
          ["table", "Structured data"],
          ["image", "Figures with caption"],
          ["code", "Monospace excerpts"]
        ]
      },
      {
        "id": "h5",
        "type": "h2",
        "text": "Image"
      },
      {
        "id": "img1",
        "type": "image",
        "src": "data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%20480%20320%22%3E%3Cdefs%3E%3ClinearGradient%20id%3D%22g%22%20x1%3D%220%22%20y1%3D%220%22%20x2%3D%221%22%20y2%3D%221%22%3E%3Cstop%20offset%3D%220%22%20stop-color%3D%234a6278%2F%3E%3Cstop%20offset%3D%221%22%20stop-color%3D%232f4759%2F%3E%3C%2FlinearGradient%3E%3C%2Fdefs%3E%3Crect%20width%3D%22480%22%20height%3D%22320%22%20fill%3D%22url%28%23g%29%22%2F%3E%3Ctext%20x%3D%22240%22%20y%3D%22168%22%20font-family%3D%22Georgia%2Cserif%22%20font-size%3D%2224%22%20fill%3D%22%23fff%22%20text-anchor%3D%22middle%22%3EFigure%3C%2Ftext%3E%3C%2Fsvg%3E",
        "caption": "Embedded SVG figure with width percent",
        "width": 72
      }
    ]
  }
}
